

# Added by skill
ASSISTANT_HAS_OWN_NUMBER=

# Added by skill
TELEGRAM_BOT_TOKEN=

# Claude authentication
# Set CLAUDE_CONFIG_DIR to the directory where Claude Code stores .credentials.json
# (e.g. ~/.claude-sriom for an aliased install, or ~/.claude for a standard install).
# The credential proxy reads fresh OAuth tokens from there automatically.
# Falls back to CLAUDE_CODE_OAUTH_TOKEN if the credentials file is unavailable.
# CLAUDE_CONFIG_DIR=~/.claude
# CLAUDE_CODE_OAUTH_TOKEN=    # only needed as fallback if CLAUDE_CONFIG_DIR is unset
# ANTHROPIC_API_KEY=          # alternative: use an API key instead of OAuth

# Model selection (optional — defaults shown)
# MODEL_INTERACTIVE=claude-sonnet-4-6
# MODEL_SCHEDULED=claude-haiku-4-5-20251001

# Jira (optional — enables reading and managing Jira tickets)
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Outlook/Microsoft Graph (optional — enables email reading and draft creation)
# See: npx tsx scripts/outlook-auth.ts
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REFRESH_TOKEN=

# AWS (optional — enables AWS CLI commands in container)
# Create a dedicated IAM user with least-privilege permissions
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2

# Lookout (optional — enables aged care CRM data access)
# API keys: Settings > Manage API keys > New Platform API Auth (Technical role required)
# Docs: https://developers.thelookoutway.com/docs/overview
LOOKOUT_API_BASE_URL=https://api.thelookoutapp.com
LOOKOUT_COMPANY_ID=
LOOKOUT_API_KEY=
